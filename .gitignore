node_modules/
*.vsix
dist/
# Not the whole folder: launch.json and tasks.json are what make the F5
# workflow in CONTRIBUTING actually work, so they ship with the repo. Personal
# settings.json stays ignored — it is machine-specific.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
scratchpad/

# The VS Code build @vscode/test-electron downloads for the in-editor suite
# (~325 MB). Cached between runs; never committed.
.vscode-test/

# eval run artifacts (keep named baselines, ignore ad-hoc runs)
eval/results/*
!eval/results/baseline*.json
eval-weak.log
panel-preview.html

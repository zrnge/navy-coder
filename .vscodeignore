.vscode/**
node_modules/**
.git/**
*.vscodeignore
.eslintrc*
.prettierrc*
scratchpad/**
*.sh
src/**
test/**
eval/**
# Navy's own session state from developing/testing Navy on this repo. Git
# ignores it via .navy/.gitignore, but vsce doesn't read nested .gitignores —
# so without this it was packaged into the VSIX, shipping local chat history
# and absolute developer paths to every user who installed the extension.
.navy/**
*.vsix
.gitignore
**/*.map
# CI config — repository tooling, of no use inside an installed extension.
.github/**
# Same: the icon generator runs against a Font Awesome package at development
# time and writes src/icons.js, which is what the bundle actually carries.
tools/**

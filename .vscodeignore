.vscode/**
# NOT covered by the line above - '.vscode/**' does not match '.vscode-test'.
# It is the VS Code build @vscode/test-electron downloads for `npm run
# test:vscode`, and it is over a gigabyte. Anyone who ran the integration suite
# before packaging (CI does, on every push) would otherwise ship the whole
# editor inside the extension.
.vscode-test/**
node_modules/**
.git/**
*.vscodeignore
.eslintrc*
# The flat-config filename the project actually uses now; .eslintrc* predates
# the migration and stopped matching anything.
eslint.config.js
.prettierrc*
scratchpad/**
*.sh
src/**
test/**
eval/**
# Navy's own session state from developing/testing Navy on this repo. Git
# ignores it via .navy/.gitignore, but vsce doesn't read nested .gitignores —
# so without this it was packaged into the VSIX, shipping local chat history
# and absolute developer paths to every user who installed the extension.
.navy/**
*.vsix
.gitignore
**/*.map
# CI config — repository tooling, of no use inside an installed extension.
.github/**
# Same: the icon generator runs against a Font Awesome package at development
# time and writes src/icons.js, which is what the bundle actually carries.
tools/**
panel-preview.html
